/**
 * ============================================================
 *  GeeksforGeeks – Problem of the Day
 * ============================================================
 *
 * 📅 Date       : 20 January 2026
 * 📌 Problem    : Design Text Editor (Undo & Redo)
 * 🟡 Difficulty : Medium
 *
 * ------------------------------------------------------------
 * 🧩 Problem Description:
 *
 * You are given an initially empty text document.
 * Implement the following operations:
 *
 * 1️⃣ append(char x) → Append character x at the end.
 * 2️⃣ undo()         → Remove the most recently appended character.
 * 3️⃣ redo()         → Reapply the most recently undone operation.
 * 4️⃣ read()         → Return current document as a string.
 *
 * Queries are given in numeric form:
 *
 * 1 x → append(x)
 * 2   → undo()
 * 3   → redo()
 * 4   → read()
 *
 * ------------------------------------------------------------
 * 💡 Approach:
 *
 * We use TWO STACKS:
 *
 * 🔹 doc Stack:
 *    Stores current characters of the document.
 *
 * 🔹 redoStack:
 *    Stores characters removed via undo().
 *
 * ------------------------------------------------------------
 * 🔁 Operation Logic:
 *
 * ✔ append(x):
 *     - Push x into doc stack.
 *     - Clear redoStack (because new operation invalidates redo history).
 *
 * ✔ undo():
 *     - If doc is not empty:
 *         pop from doc
 *         push into redoStack
 *
 * ✔ redo():
 *     - If redoStack is not empty:
 *         pop from redoStack
 *         push into doc
 *
 * ✔ read():
 *     - Traverse doc stack
 *     - Build and return string
 *
 * ------------------------------------------------------------
 * ⏱️ Complexity Analysis:
 *
 * append() → O(1)
 * undo()   → O(1)
 * redo()   → O(1)
 * read()   → O(N)
 *
 * Space Complexity → O(N)
 *
 * ------------------------------------------------------------
 * 🧪 Example:
 *
 * Input:
 *   [1 'A'], [1 'B'], [1 'C'], [2], [4], [3], [4]
 *
 * Output:
 *   ["AB", "ABC"]
 *
 * ------------------------------------------------------------
 * 🛠️ Designed for GFG driver environment
 * ============================================================
 */

import java.util.*;

class Solution {

    Stack<Character> doc = new Stack<>();
    Stack<Character> redoStack = new Stack<>();

    // Append character x to the document
    void append(char x) {
        doc.push(x);
        // Clear redo history when a new append happens
        redoStack.clear();
    }

    // Undo the most recent append
    void undo() {
        if (!doc.isEmpty()) {
            redoStack.push(doc.pop());
        }
    }

    // Redo the most recent undone operation
    void redo() {
        if (!redoStack.isEmpty()) {
            doc.push(redoStack.pop());
        }
    }

    // Return the current document content
    String read() {
        StringBuilder sb = new StringBuilder();
        for (char ch : doc) {
            sb.append(ch);
        }
        return sb.toString();
    }
}
