/**
 * ============================================================
 *  GeeksforGeeks – Problem of the Day
 * ============================================================
 *
 * 📅 Date       : 16 January 2026
 * 📌 Problem    : Minimum People to Cover the Working Day
 * 🟡 Difficulty : Medium
 *
 * ------------------------------------------------------------
 * 🧩 Problem Description:
 * You are given an array `arr[]` of size `n`.
 *
 * If arr[i] ≠ -1:
 *   The person at index i can cover the interval
 *   [i - arr[i], i + arr[i]].
 *
 * If arr[i] = -1:
 *   The person is unavailable.
 *
 * The goal is to determine the minimum number of people
 * required to fully cover the working day from time 0
 * to n - 1.
 *
 * If full coverage is not possible, return -1.
 *
 * ------------------------------------------------------------
 * 💡 Approach (Greedy Interval Covering):
 *
 * 1. Convert each valid person into an interval:
 *      start = max(0, i - arr[i])
 *      end   = min(n - 1, i + arr[i])
 *
 * 2. Sort intervals based on start time
 *
 * 3. Use greedy technique similar to minimum interval
 *    covering problem:
 *      - Maintain `coveredTill`
 *      - Among intervals starting before or at coveredTill,
 *        choose the one that extends coverage the farthest
 *      - Increment count
 *
 * 4. If at any point no interval can extend coverage,
 *    return -1
 *
 * ------------------------------------------------------------
 * ⏱️ Complexity Analysis:
 * Time Complexity  : O(N log N)  (due to sorting)
 * Space Complexity : O(N)
 *
 * ------------------------------------------------------------
 * 🧪 Examples:
 *
 * Input:
 *   arr = [1, 2, 1, 0]
 * Output:
 *   1
 *
 * Input:
 *   arr = [2, 3, 4, -1, 2, 0, 0, -1, 0]
 * Output:
 *   -1
 *
 * Input:
 *   arr = [0, 1, 0, -1]
 * Output:
 *   -1
 *
 * ------------------------------------------------------------
 * 🛠️ Usage:
 * This method is intended to be used within the
 * GeeksforGeeks evaluation framework.
 *
 * ============================================================
 */

import java.util.*;

class Solution {

    public int minMen(int[] arr) {

        int n = arr.length;
        List<int[]> intervals = new ArrayList<>();

        // Step 1: Create intervals
        for (int i = 0; i < n; i++) {
            if (arr[i] != -1) {
                int start = Math.max(0, i - arr[i]);
                int end = Math.min(n - 1, i + arr[i]);
                intervals.add(new int[]{start, end});
            }
        }

        // Step 2: Sort by start time
        intervals.sort((a, b) -> a[0] - b[0]);

        int coveredTill = 0;
        int count = 0;
        int i = 0;

        // Step 3: Greedy interval covering
        while (coveredTill < n) {

            int maxEnd = -1;

            while (i < intervals.size() && intervals.get(i)[0] <= coveredTill) {
                maxEnd = Math.max(maxEnd, intervals.get(i)[1]);
                i++;
            }

            if (maxEnd < coveredTill) {
                return -1;
            }

            count++;
            coveredTill = maxEnd + 1;
        }

        return count;
    }
}
