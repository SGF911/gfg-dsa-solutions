/**
 * ============================================================
 *  GeeksforGeeks – Problem of the Day
 * ============================================================
 *
 * 📅 Date       : 06 February 2026
 * 📌 Problem    : Max XOR Subarray of Size K
 * 🟡 Difficulty : Medium
 *
 * ------------------------------------------------------------
 * 🧩 Problem Description:
 * Given an integer array `arr[]` and an integer `k`, find the
 * maximum XOR value of any contiguous subarray of size `k`.
 *
 * A subarray is a contiguous part of the array.
 *
 * ------------------------------------------------------------
 * 💡 Approach (Sliding Window with XOR):
 * 1. Compute XOR of the first window of size `k`
 * 2. Slide the window one element at a time:
 *    - Remove the leftmost element using XOR
 *    - Add the next element using XOR
 * 3. Track the maximum XOR value encountered
 *
 * XOR is reversible, making it efficient to update the window
 * in constant time.
 *
 * ------------------------------------------------------------
 * ⏱️ Complexity Analysis:
 * Time Complexity  : O(N)
 * Space Complexity : O(1)
 *
 * ------------------------------------------------------------
 * 🧪 Examples:
 *
 * Input:
 *   arr = [2, 5, 8, 1, 1, 3], k = 3
 * Output:
 *   15
 *
 * Input:
 *   arr = [1, 2, 4, 5, 6], k = 2
 * Output:
 *   6
 *
 * ------------------------------------------------------------
 * 🛠️ Usage:
 * This method is intended to be used within the
 * GeeksforGeeks evaluation framework.
 *
 * ============================================================
 */

class Solution {

    public static int maxSubarrayXOR(int[] arr, int k) {
        int n = arr.length;
        int windowXor = 0;

        // XOR of first window
        for (int i = 0; i < k; i++) {
            windowXor ^= arr[i];
        }

        int maxXor = windowXor;

        // Slide the window
        for (int i = k; i < n; i++) {
            windowXor ^= arr[i - k]; // remove left element
            windowXor ^= arr[i];     // add right element
            maxXor = Math.max(maxXor, windowXor);
        }

        return maxXor;
    }
}
