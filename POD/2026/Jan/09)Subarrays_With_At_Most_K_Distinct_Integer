/**
 * ============================================================
 *  GeeksforGeeks – Problem of the Day
 * ============================================================
 *
 * 📅 Date       : 09 February 2026
 * 📌 Problem    : Subarrays With At Most K Distinct Integers
 * 🟡 Difficulty : Medium
 *
 * ------------------------------------------------------------
 * 🧩 Problem Description:
 * Given an array `arr[]` of positive integers and an integer
 * `k`, count the number of contiguous subarrays that contain
 * at most `k` distinct integers.
 *
 * ------------------------------------------------------------
 * 💡 Approach (Sliding Window + Frequency Map):
 * 1. Use a HashMap to store frequencies of elements in the
 *    current window
 * 2. Expand the window using the right pointer
 * 3. Shrink the window from the left while the number of
 *    distinct elements exceeds `k`
 * 4. For each valid window, add the number of subarrays
 *    ending at `right` → (right - left + 1)
 *
 * ------------------------------------------------------------
 * ⏱️ Complexity Analysis:
 * Time Complexity  : O(N)
 * Space Complexity : O(K)
 *
 * ------------------------------------------------------------
 * 🧪 Examples:
 *
 * Input:
 *   arr = [1, 2, 2, 3], k = 2
 * Output:
 *   9
 *
 * Input:
 *   arr = [1, 1, 1], k = 1
 * Output:
 *   6
 *
 * Input:
 *   arr = [1, 2, 1, 1, 3, 3, 4, 2, 1], k = 2
 * Output:
 *   24
 *
 * ------------------------------------------------------------
 * 🛠️ Usage:
 * This method is intended to be used within the
 * GeeksforGeeks evaluation framework.
 *
 * ============================================================
 */

import java.util.HashMap;

class Solution {

    long countAtMostK(int[] arr, int k) {
        if (k == 0) return 0;

        HashMap<Integer, Integer> freq = new HashMap<>();
        int left = 0;
        long count = 0;

        for (int right = 0; right < arr.length; right++) {

            // Add current element to the window
            freq.put(arr[right], freq.getOrDefault(arr[right], 0) + 1);

            // Shrink window if distinct count exceeds k
            while (freq.size() > k) {
                freq.put(arr[left], freq.get(arr[left]) - 1);
                if (freq.get(arr[left]) == 0) {
                    freq.remove(arr[left]);
                }
                left++;
            }

            // Count valid subarrays ending at 'right'
            count += (right - left + 1);
        }

        return count;
    }
}
