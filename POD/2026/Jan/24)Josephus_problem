/**
 * ============================================================
 *  GeeksforGeeks – Problem of the Day
 * ============================================================
 *
 * 📅 Date       : 24 January 2026
 * 📌 Problem    : Josephus Problem
 * 🟡 Difficulty : Medium
 *
 * ------------------------------------------------------------
 * 🧩 Problem Description:
 *
 * There are n people standing in a circle numbered from
 * 1 to n. Starting from person 1, every kth person is
 * eliminated in circular order.
 *
 * The process continues until only one person remains.
 *
 * Return the position (1-based index) of the survivor.
 *
 * ------------------------------------------------------------
 * 💡 Approach (Mathematical Recurrence – Iterative DP):
 *
 * This is the classic Josephus Problem.
 *
 * Recurrence relation:
 *
 *      J(1, k) = 0
 *      J(n, k) = (J(n-1, k) + k) % n
 *
 * Where J(n, k) gives the safe position (0-based index).
 *
 * Instead of recursion, we compute it iteratively:
 *
 * 1️⃣ Start with result = 0 (for n = 1)
 * 2️⃣ For i from 2 to n:
 *        result = (result + k) % i
 * 3️⃣ Convert to 1-based index by adding 1
 *
 * This avoids recursion overhead and works efficiently.
 *
 * ------------------------------------------------------------
 * ⏱️ Complexity Analysis:
 *
 * Time Complexity  : O(n)
 * Space Complexity : O(1)
 *
 * ------------------------------------------------------------
 * 🧪 Example:
 *
 * Input:
 *   n = 5, k = 2
 *
 * Output:
 *   3
 *
 * ------------------------------------------------------------
 * 🛠️ Designed for GFG driver environment
 * ============================================================
 */

class Solution {
    public int josephus(int n, int k) {
        int res = 0; // J(1, k) = 0 (0-based index)

        for (int i = 2; i <= n; i++) {
            res = (res + k) % i;
        }

        return res + 1; // Convert to 1-based index
    }
}
